<view class="tabbar-wrapper safe-area-bottom">
  <view class="tabbar-container">
    <view 
      class="tabbar-item {{active === 'home' ? 'active' : ''}}"
      bindtap="switchTab"
      data-tab="home"
    >
      <image class="tabbar-icon" src="{{active === 'home' ? '/assets/icons/tabbar/home-active.png' : '/assets/icons/tabbar/home.png'}}" mode="aspectFit"/>
      <text class="tabbar-text">首页</text>
    </view>
    <view 
      class="tabbar-item {{active === 'growth' ? 'active' : ''}}"
      bindtap="switchTab"
      data-tab="growth"
    >
      <image class="tabbar-icon" src="{{active === 'growth' ? '/assets/icons/tabbar/growth-active.png' : '/assets/icons/tabbar/growth.png'}}" mode="aspectFit"/>
      <text class="tabbar-text">成长</text>
    </view>
    <view 
      class="tabbar-item {{active === 'community' ? 'active' : ''}}"
      bindtap="switchTab"
      data-tab="community"
    >
      <image class="tabbar-icon" src="{{active === 'community' ? '/assets/icons/tabbar/community-active.png' : '/assets/icons/tabbar/community.png'}}" mode="aspectFit"/>
      <text class="tabbar-text">社群</text>
    </view>
    <view 
      class="tabbar-item {{active === 'settings' ? 'active' : ''}}"
      bindtap="switchTab"
      data-tab="settings"
    >
      <image class="tabbar-icon" src="{{active === 'settings' ? '/assets/icons/tabbar/settings-active.png' : '/assets/icons/tabbar/settings.png'}}" mode="aspectFit"/>
      <text class="tabbar-text">设置</text>
    </view>
  </view>
</view>
