.doudou-wrapper {
  position: fixed;
  z-index: 90;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.doudou-body {
  width: 116rpx;
  height: 116rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: float 3s ease-in-out infinite;
  transition: transform 0.3s ease;
}

.doudou-image {
  width: 116rpx;
  height: 116rpx;
}

.doudou-voice {
  background: #FFFCF8;
  border-radius: 20rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(93, 78, 55, 0.1);
  max-width: 300rpx;
  word-break: break-all;
  position: relative;
}

.doudou-voice::after {
  content: '';
  position: absolute;
  bottom: -12rpx;
  right: 30rpx;
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-top: 16rpx solid #FFFCF8;
}

.voice-text {
  font-size: 26rpx;
  color: #5D4E37;
  line-height: 1.5;
}
