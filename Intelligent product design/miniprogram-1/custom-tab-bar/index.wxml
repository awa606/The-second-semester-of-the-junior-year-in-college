<view class="tabbar-wrapper safe-area-bottom">
  <view class="tabbar-container">
    <view class="tabbar-item {{selected === 0 ? 'active' : ''}}" bindtap="switchTab" data-index="0" data-path="/pages/home/home">
      <image class="tabbar-icon" src="{{selected === 0 ? '/assets/icons/tabbar/home-active.png' : '/assets/icons/tabbar/home.png'}}" mode="aspectFit"/>
      <text class="tabbar-text">首页</text>
    </view>
    <view class="tabbar-item {{selected === 1 ? 'active' : ''}}" bindtap="switchTab" data-index="1" data-path="/pages/growth/growth">
      <image class="tabbar-icon" src="{{selected === 1 ? '/assets/icons/tabbar/growth-active.png' : '/assets/icons/tabbar/growth.png'}}" mode="aspectFit"/>
      <text class="tabbar-text">成长</text>
    </view>
    <view class="tabbar-item {{selected === 2 ? 'active' : ''}}" bindtap="switchTab" data-index="2" data-path="/pages/community/community">
      <image class="tabbar-icon" src="{{selected === 2 ? '/assets/icons/tabbar/community-active.png' : '/assets/icons/tabbar/community.png'}}" mode="aspectFit"/>
      <text class="tabbar-text">社群</text>
    </view>
    <view class="tabbar-item {{selected === 3 ? 'active' : ''}}" bindtap="switchTab" data-index="3" data-path="/pages/settings/settings">
      <image class="tabbar-icon" src="{{selected === 3 ? '/assets/icons/tabbar/settings-active.png' : '/assets/icons/tabbar/settings.png'}}" mode="aspectFit"/>
      <text class="tabbar-text">设置</text>
    </view>
  </view>
</view>
