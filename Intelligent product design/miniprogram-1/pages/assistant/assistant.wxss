.assistant-page { height: 100vh; background: #fff8f0; display: flex; flex-direction: column; }
.nav-bar { background: #ffeede; border-bottom: 1rpx solid #f3deca; }
.nav-inner { height: 92rpx; padding: 0 28rpx; display: flex; align-items: center; justify-content: space-between; }
.page-title { font-size: 34rpx; color: #7f5e4f; font-weight: 700; }
.clear-btn { font-size: 26rpx; color: #b18164; }
.welcome-card { margin: 20rpx 24rpx 14rpx; background: #fff3e4; border-radius: 24rpx; padding: 18rpx; display: flex; gap: 16rpx; align-items: center; }
.mascot { width: 96rpx; height: 96rpx; flex-shrink: 0; }
.welcome-text { color: #7f5d4a; font-size: 24rpx; line-height: 1.6; }
.chat-list { flex: 1; padding: 6rpx 24rpx; }
.message-row { display: flex; margin-bottom: 14rpx; }
.user-row { justify-content: flex-end; }
.assistant-row { justify-content: flex-start; }
.bubble { max-width: 82%; border-radius: 20rpx; padding: 16rpx 20rpx; }
.bubble.user { background: #f6cfae; color: #6a4738; border-bottom-right-radius: 8rpx; }
.bubble.assistant { background: #fffdf9; border: 1rpx solid #f1ded0; color: #6f5649; border-bottom-left-radius: 8rpx; }
.bubble-text { white-space: pre-wrap; font-size: 26rpx; line-height: 1.62; }
.quick-list { padding: 10rpx 24rpx; display: flex; flex-wrap: wrap; gap: 10rpx; background: #fff4e9; }
.quick-item { padding: 10rpx 18rpx; border: 1rpx solid #eddccf; border-radius: 999rpx; background: #fffdf9; color: #7a5b49; font-size: 23rpx; }
.input-bar { padding: 14rpx 20rpx calc(14rpx + env(safe-area-inset-bottom)); background: #fff1e4; display: flex; gap: 14rpx; border-top: 1rpx solid #f5dcc7; }
.question-input { flex: 1; background: #fff; border-radius: 34rpx; padding: 0 24rpx; height: 70rpx; font-size: 26rpx; }
.send-btn { width: 140rpx; height: 70rpx; line-height: 70rpx; border-radius: 35rpx; border: none; background: #e8a87c; color: #fff; font-size: 26rpx; padding: 0; }
