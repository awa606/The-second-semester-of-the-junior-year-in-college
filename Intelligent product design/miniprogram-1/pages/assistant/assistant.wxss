.assistant-page {
  min-height: 100vh;
  background: #fff8f0;
  display: flex;
  flex-direction: column;
}

.nav-bar {
  padding: 88rpx 32rpx 24rpx;
  background: #ffeede;
}

.page-title {
  font-size: 36rpx;
  color: #7f5e4f;
  font-weight: 700;
}

.chat-list {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
}

.quick-list {
  background: #fff3e6;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.quick-title {
  font-size: 28rpx;
  color: #8d6b59;
  font-weight: 600;
}

.quick-item {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  background: #ffffff;
  border-radius: 16rpx;
  color: #7a5b49;
  font-size: 26rpx;
}

.message-row { margin-bottom: 20rpx; display: flex; }
.user-row { justify-content: flex-end; }
.assistant-row { justify-content: flex-start; }

.bubble {
  max-width: 82%;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
}

.bubble.user {
  background: #f6cfae;
  color: #6a4738;
  border-bottom-right-radius: 8rpx;
}

.bubble.assistant {
  background: #ffffff;
  border: 2rpx solid #f1ded0;
  color: #6f5649;
  border-bottom-left-radius: 8rpx;
}

.bubble.pending {
  opacity: 0.7;
}

.bubble-text { white-space: pre-wrap; font-size: 26rpx; line-height: 1.65; }

.input-bar {
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff1e4;
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.question-input {
  flex: 1;
  background: #fff;
  border-radius: 36rpx;
  padding: 0 26rpx;
  height: 72rpx;
  color: #6b5042;
  font-size: 26rpx;
}

.input-placeholder { color: #c8ad98; }

.send-btn {
  width: 138rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  border: none;
  background: #e8a87c;
  color: #fff;
  font-size: 28rpx;
}
