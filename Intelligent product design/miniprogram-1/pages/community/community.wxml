<view class="community-page">
  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}" bindscrolltolower="onLoadMore">
    <view class="nav-bar safe-area-top">
      <view class="nav-content"><text class="page-title">宝妈社群</text></view>
    </view>
    <view class="post-list">
      <view class="masonry">
        <view class="post-card {{item.height === 'tall' ? 'tall' : ''}}" wx:for="{{posts}}" wx:key="id" bindtap="onPostTap" data-id="{{item.id}}">
          <view class="post-image-wrapper" wx:if="{{item.images.length > 0}}"><text class="post-image-placeholder">{{item.imageEmoji}}</text></view>
          <view class="post-content">
            <text class="post-title text-ellipsis-2">{{item.title}}</text>
            <view class="post-tags" wx:if="{{item.tags.length > 0}}"><text class="post-tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="index">{{tag}}</text></view>
            <view class="post-author"><view class="author-avatar-placeholder">{{item.avatarEmoji}}</view><text class="author-name">{{item.author}}</text><view class="post-meta"><image class="meta-icon" src="/assets/icons/community/like-heart.png" mode="aspectFit"/><text class="meta-text">{{item.likes}}</text></view></view>
          </view>
        </view>
      </view>
      <view class="load-more" wx:if="{{hasMore}}"><text class="loading-text">加载更多...</text></view>
      <view class="load-more" wx:else><text class="loading-text">— 没有更多了 —</text></view>
    </view>
  </scroll-view>
  <view class="floating-post-btn" bindtap="onCreatePost"><text>发帖</text></view>
  <doudou bottom="180" right="30" bind:doudouclick="onDoudouClick" />
</view>
