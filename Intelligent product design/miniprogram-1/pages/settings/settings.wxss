.settings-page {
  height: 100vh;
  box-sizing: border-box;
  background-color: #FFF8F0;
  overflow: hidden;
}

.page-scroll {
  height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

/* 导航栏 */
.nav-bar {
  background: #FFFFFF;
  padding: 120rpx 32rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(93, 78, 55, 0.05);
  text-align: center;
}

.page-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #5D4E37;
}

/* 设置内容 */
.settings-content {
  padding: 24rpx 32rpx 40rpx;
}

/* 设置分组 */
.settings-group {
  margin-bottom: 24rpx;
  padding: 8rpx 0;
}

.group-header {
  padding: 12rpx 24rpx 20rpx;
}

.group-title {
  font-size: 26rpx;
  color: #B8A090;
  font-weight: 500;
}

/* 设置项 */
.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  transition: background 0.2s ease;
}

.setting-item:active {
  background: rgba(93, 78, 55, 0.03);
}

.item-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.item-icon {
  font-size: 36rpx;
  width: 40rpx;
  text-align: center;
}

.item-icon.danger {
  opacity: 0.6;
}

.item-label {
  font-size: 30rpx;
  color: #5D4E37;
}

.item-label.danger {
  color: #F44336;
  opacity: 0.8;
}

.item-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.item-value {
  font-size: 28rpx;
  color: #B8A090;
}

.item-arrow {
  font-size: 36rpx;
  color: #D0C4B4;
  font-weight: 300;
}

.status-badge {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}

.status-badge.online {
  background: rgba(76, 175, 80, 0.1);
  color: #4CAF50;
}

.status-badge.offline {
  background: rgba(158, 158, 158, 0.1);
  color: #9E9E9E;
}

/* 退出登录 */
.logout-btn {
  width: 100%;
  margin-top: 40rpx;
  padding: 28rpx 0;
  background: #FFFFFF;
  border: none;
  border-radius: 24rpx;
  font-size: 32rpx;
  color: #F44336;
  font-weight: 500;
  box-shadow: 0 4rpx 16rpx rgba(93, 78, 55, 0.06);
}

.logout-btn::after {
  border: none;
}

.logout-btn:active {
  background: #FFF5F5;
}

.item-left{flex:1;min-width:0;display:flex;align-items:center;}
.item-label{white-space:nowrap;flex-shrink:0;display:inline-block;}
.item-right{flex-shrink:0;display:flex;align-items:center;}
.item-value,.status-badge,.item-arrow{white-space:nowrap;}
