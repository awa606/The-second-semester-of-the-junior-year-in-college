<wxs module="utils">
module.exports = {
  getModeText: function(mode) {
    var texts = {
      warm: '保温模式',
      dispense: '出奶模式',
      sterilize: '消毒模式',
      standby: '待机中'
    };
    return texts[mode] || '待机中';
  }
}
</wxs>

<view class="home-page">
  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="nav-bar safe-area-top">
      <view class="nav-title-row">
        <text class="nav-title">智育</text>
      </view>
      <view class="nav-status-row">
        <view class="device-status {{deviceInfo.connected ? 'online' : 'offline'}}">
          <view class="status-dot"></view>
          <text class="status-name">{{deviceInfo.connected ? deviceInfo.name : '未连接'}}</text>
        </view>
        <view class="status-icons">
          <view class="status-item">
            <image class="status-icon" src="/assets/icons/home/battery.png" mode="aspectFit"/>
            <text class="status-value">{{deviceInfo.battery}}%</text>
          </view>
          <view class="status-item">
            <image class="status-icon" src="/assets/icons/home/water-level.png" mode="aspectFit"/>
            <text class="status-value">{{deviceInfo.waterLevel}}%</text>
          </view>
        </view>
      </view>
      <view class="nav-action-row">
        <view class="add-device-btn" bindtap="goToPair">
          <text class="add-icon">+</text>
          <text class="add-text">添加设备</text>
        </view>
      </view>
    </view>

    <view class="reminder-section">
      <text class="reminder-text">🌡️ 当前水温 {{deviceInfo.temperature}}°C · 适合宝宝饮用</text>
    </view>

    <view class="device-card card">
      <view class="device-main">
        <view class="device-visual">
          <image class="device-emoji" src="/assets/icons/home/device-station.png" mode="aspectFit"/>
          <view class="device-glow"></view>
        </view>
        <view class="device-info">
          <text class="device-name">{{deviceInfo.name}}</text>
          <text class="device-mode">{{utils.getModeText(currentMode)}}</text>
          <text class="device-temp">水温 {{deviceInfo.temperature}}°C</text>
        </view>
      </view>
    </view>

    <view class="action-buttons">
      <view class="action-btn {{currentMode === 'warm' ? 'active' : ''}}" bindtap="setMode" data-mode="warm">
        <image class="action-icon" src="/assets/icons/home/warm.png" mode="aspectFit"/>
        <text class="action-text">保温</text>
      </view>
      <view class="action-btn {{currentMode === 'dispense' ? 'active' : ''}}" bindtap="setMode" data-mode="dispense">
        <text class="action-icon clean-text-icon">🍼</text>
        <text class="action-text">出奶</text>
      </view>
      <view class="action-btn {{currentMode === 'sterilize' ? 'active' : ''}}" bindtap="setMode" data-mode="sterilize">
        <text class="action-icon clean-text-icon">✨</text>
        <text class="action-text">消毒</text>
      </view>
    </view>

    <view class="control-section card">
      <view class="control-header">
        <text class="control-title">温度调节</text>
        <text class="control-value">{{targetTemp}}°C</text>
      </view>
      <slider class="temp-slider" min="30" max="50" step="1" value="{{targetTemp}}" block-size="24" bindchange="onTempChange" activeColor="#E8A87C" backgroundColor="#F0E6DC" />
      <view class="slider-labels">
        <text>30°C</text>
        <text>40°C</text>
        <text>50°C</text>
      </view>
    </view>

    <view class="control-section card">
      <view class="control-header">
        <text class="control-title">定时功能</text>
        <view class="timer-add-btn" bindtap="onAddTimer">
          <text class="timer-add-icon">+</text>
          <text class="timer-add-text">添加定时</text>
        </view>
      </view>
      <view class="timer-list" wx:if="{{timers && timers.length > 0}}">
        <view class="timer-item" wx:for="{{timers}}" wx:key="id">
          <picker mode="time" value="{{item.time}}" data-id="{{item.id}}" bindchange="onTimerTimeChange">
            <view class="timer-time">
              <image class="timer-icon" src="/assets/icons/home/timer.png" mode="aspectFit"/>
              <text class="timer-text">{{item.time}}</text>
              <text class="timer-arrow">›</text>
            </view>
          </picker>
          <switch class="timer-switch" checked="{{item.enabled}}" data-id="{{item.id}}" bindchange="onToggleTimer" color="#E8A87C"/>
          <view class="timer-delete-btn" data-id="{{item.id}}" bindtap="onDeleteTimer">删除</view>
        </view>
      </view>
      <view class="timer-empty" wx:if="{{!timers || timers.length === 0}}">
        <text>暂无定时，点击“+ 添加定时”创建</text>
      </view>
    </view>

    <view class="bottom-safe-spacer"></view>
  </scroll-view>
  <tabbar active="home" />
  <doudou bottom="210" right="30" bind:doudouclick="onDoudouClick" />
</view>
