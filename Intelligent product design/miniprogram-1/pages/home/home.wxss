.home-page {
  height: 100vh;
  background-color: #FFF8F0;
  overflow: hidden;
}

.page-scroll {
  height: 100vh;
  box-sizing: border-box;
  padding-bottom: 260rpx;
}

.nav-bar {
  background: #FFFFFF;
  padding: 136rpx 32rpx 26rpx;
  box-shadow: 0 2rpx 12rpx rgba(93, 78, 55, 0.05);
}

.nav-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 56rpx;
}

.nav-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #5D4E37;
  white-space: nowrap;
}

.nav-status-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
  gap: 20rpx;
}

.nav-action-row {
  display: flex;
  justify-content: flex-end;
  margin-top: 18rpx;
}

.device-status {
  display: flex;
  align-items: center;
  min-width: 0;
  max-width: 320rpx;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  box-sizing: border-box;
}

.device-status.online {
  background: rgba(76, 175, 80, 0.1);
  color: #4CAF50;
}

.device-status.offline {
  background: rgba(244, 67, 54, 0.1);
  color: #F44336;
}

.status-name {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.add-device-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 168rpx;
  height: 60rpx;
  padding: 0 24rpx;
  background: linear-gradient(135deg, #E8A87C 0%, #F5C6A5 100%);
  border-radius: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(232, 168, 124, 0.3);
  box-sizing: border-box;
}

.add-icon {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 700;
  margin-right: 6rpx;
}

.add-text {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 500;
  white-space: nowrap;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 8rpx;
  flex-shrink: 0;
  background: currentColor;
  animation: pulse 2s infinite;
}

.status-icons {
  display: flex;
  align-items: center;
  gap: 28rpx;
  flex-shrink: 0;
}

.status-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  white-space: nowrap;
}

.status-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.status-value {
  font-size: 26rpx;
  color: #5D4E37;
  font-weight: 500;
  white-space: nowrap;
}

.reminder-section {
  padding: 24rpx 32rpx;
}

.reminder-text {
  font-size: 26rpx;
  color: #8B7355;
  background: linear-gradient(90deg, rgba(232, 168, 124, 0.1) 0%, rgba(245, 198, 165, 0.1) 100%);
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  display: inline-block;
}

.device-card {
  margin: 0 32rpx 32rpx;
}

.device-main {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.device-visual {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.device-emoji {
  width: 100rpx;
  height: 100rpx;
  position: relative;
  z-index: 1;
}

.device-glow {
  position: absolute;
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, rgba(232, 168, 124, 0.3) 0%, rgba(245, 198, 165, 0.1) 100%);
  border-radius: 50%;
  animation: pulse 3s ease-in-out infinite;
}

.device-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.device-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #5D4E37;
  white-space: nowrap;
}

.device-mode {
  font-size: 28rpx;
  color: #E8A87C;
  font-weight: 500;
  white-space: nowrap;
}

.device-temp {
  font-size: 24rpx;
  color: #B8A090;
  white-space: nowrap;
}

.action-buttons {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 0 32rpx 32rpx;
}

.action-btn {
  flex: 1;
  height: 160rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(93, 78, 55, 0.06);
  transition: all 0.3s ease;
  border: 4rpx solid transparent;
  box-sizing: border-box;
}

.action-btn.active {
  border-color: #E8A87C;
  background: linear-gradient(135deg, rgba(232, 168, 124, 0.1) 0%, rgba(245, 198, 165, 0.1) 100%);
}

.action-icon {
  width: 56rpx;
  height: 56rpx;
}

.clean-text-icon {
  width: auto;
  height: auto;
  font-size: 56rpx;
  line-height: 1;
}

.action-text {
  font-size: 28rpx;
  color: #5D4E37;
  font-weight: 500;
  white-space: nowrap;
}

.control-section {
  margin: 0 32rpx 24rpx;
}

.control-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  gap: 16rpx;
}

.control-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #5D4E37;
  white-space: nowrap;
}

.control-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #E8A87C;
  white-space: nowrap;
}

.temp-slider {
  margin: 0 16rpx;
}

.slider-labels {
  display: flex;
  justify-content: space-between;
  padding: 0 8rpx;
  margin-top: 12rpx;
}

.slider-labels text {
  font-size: 22rpx;
  color: #B8A090;
}

.timer-switch {
  transform: scale(0.85);
}

.timer-add-btn {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(232, 168, 124, 0.15);
}

.timer-add-icon {
  font-size: 26rpx;
  color: #E8A87C;
  font-weight: 700;
  margin-right: 6rpx;
}

.timer-add-text {
  font-size: 24rpx;
  color: #8B7355;
  white-space: nowrap;
}

.timer-list {
  margin-top: 12rpx;
}

.timer-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 14rpx;
  background: #FFFBF6;
  border: 1rpx solid #F3E5D8;
  border-radius: 16rpx;
  margin-top: 12rpx;
}

.timer-item picker {
  flex: 1;
  min-width: 0;
}

.timer-time {
  display: flex;
  align-items: center;
  min-width: 0;
  padding: 12rpx 16rpx;
  background: #FFF8F0;
  border-radius: 14rpx;
}

.timer-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  margin-right: 12rpx;
}

.timer-text {
  flex: 1;
  font-size: 30rpx;
  color: #5D4E37;
  font-weight: 500;
  white-space: nowrap;
}

.timer-arrow {
  font-size: 36rpx;
  color: #B8A090;
}

.timer-delete-btn {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #C47A57;
  background: rgba(255, 226, 210, 0.8);
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  white-space: nowrap;
}

.timer-empty {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  border-radius: 14rpx;
  background: #FFF8F0;
}

.timer-empty text {
  font-size: 24rpx;
  color: #B8A090;
}

.bottom-safe-spacer {
  height: 260rpx;
}
