.growth-page {
  height: 100vh;
  box-sizing: border-box;
  background-color: #FFF8F0;
  overflow: hidden;
}

.page-scroll {
  box-sizing: border-box;
  padding-top: 24rpx;
  padding-bottom: calc(300rpx + env(safe-area-inset-bottom));
}

/* 导航栏 */
.nav-bar {
  background: #FFFFFF;
  box-shadow: 0 2rpx 12rpx rgba(93, 78, 55, 0.05);
  box-sizing: border-box;
  position: relative;
  z-index: 20;
}

.nav-content {
  height: 80rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
  position: relative;
  align-items: center;
}

.page-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #5D4E37;
}

.add-btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 22rpx;
  min-width: 132rpx;
  justify-content: center;
  flex-shrink: 0;
  background: linear-gradient(135deg, #E8A87C 0%, #F5C6A5 100%);
  border-radius: 30rpx;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 500;
}

.add-btn text {
  white-space: nowrap;
}

.add-icon {
  font-size: 28rpx;
  font-weight: bold;
}

/* 宝宝卡片 */
.baby-card {
  margin: 0 32rpx 24rpx;
}

.baby-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.baby-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFE4C9 0%, #F5D5B8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
}

.baby-detail {
  flex: 1;
}

.baby-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #5D4E37;
  display: block;
  margin-bottom: 8rpx;
}

.baby-age {
  font-size: 26rpx;
  color: #B8A090;
}

.baby-stats {
  display: flex;
  flex-wrap: nowrap;
  justify-content: space-around;
  align-items: center;
  padding-top: 24rpx;
  border-top: 1rpx solid #F0E6DC;
}

.stat-item {
  flex: 1;
  min-width: 0;
  text-align: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #E8A87C;
  display: block;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #B8A090;
  white-space: nowrap;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: #F0E6DC;
}

/* 成长曲线 */
.curve-section {
  margin: 0 32rpx 24rpx;
}

.curve-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #5D4E37;
}

.tab-switch {
  display: flex;
  background: #F5EDE4;
  border-radius: 20rpx;
  padding: 4rpx;
}

.tab-item {
  padding: 10rpx 24rpx;
  font-size: 26rpx;
  color: #8B7355;
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.tab-item.active {
  background: #FFFFFF;
  color: #E8A87C;
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(93, 78, 55, 0.1);
}

.curve-chart {
  height: 240rpx;
  position: relative;
}

.chart-area {
  position: absolute;
  left: 0;
  right: 60rpx;
  top: 0;
  bottom: 40rpx;
}

.chart-line {
  position: relative;
  width: 100%;
  height: 100%;
}

.data-point {
  position: absolute;
  width: 20rpx;
  height: 20rpx;
  background: #E8A87C;
  border-radius: 50%;
  transform: translate(-50%, 50%);
  z-index: 2;
}

.data-point.highlight {
  width: 28rpx;
  height: 28rpx;
  background: linear-gradient(135deg, #E8A87C 0%, #F5C6A5 100%);
  box-shadow: 0 4rpx 12rpx rgba(232, 168, 124, 0.4);
}

.chart-grid {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.grid-line {
  height: 1rpx;
  background: #F0E6DC;
}

.chart-labels {
  position: absolute;
  left: 0;
  right: 60rpx;
  bottom: 0;
  display: flex;
  justify-content: space-between;
}

.chart-labels text {
  font-size: 22rpx;
  color: #B8A090;
}

/* 历史记录 */
.history-section {
  padding-top: 16rpx;
}

.history-title {
  margin-left: 32rpx;
}

.history-list {
  padding: 24rpx 32rpx 0;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.history-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
}

.history-item-last {
  margin-bottom: 40rpx;
}

.bottom-safe-spacer {
  height: calc(310rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}

.history-date {
  width: 80rpx;
  text-align: center;
  margin-right: 24rpx;
}

.date-day {
  font-size: 36rpx;
  font-weight: 700;
  color: #E8A87C;
  display: block;
}

.date-month {
  font-size: 22rpx;
  color: #B8A090;
}

.history-content {
  flex: 1;
  min-width: 0;
}

.record-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #5D4E37;
  display: block;
  margin-bottom: 12rpx;
}

.record-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  font-size: 22rpx;
  color: #8B7355;
  background: #FFF8F0;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}

.history-arrow {
  font-size: 40rpx;
  color: #D0C4B4;
  margin-left: 16rpx;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  justify-content: center;
  align-items: flex-end;
  padding: 32rpx;
  box-sizing: border-box;
}

.modal-card {
  width: 100%;
  max-height: 80vh;
  border-radius: 28rpx;
  box-sizing: border-box;
}

.modal-title {
  font-size: 32rpx;
  color: #5D4E37;
  font-weight: 600;
  margin-bottom: 18rpx;
}

.form-body,
.detail-body {
  max-height: 56vh;
}

.form-item {
  margin-bottom: 20rpx;
}

.form-label {
  color: #8B7355;
  font-size: 24rpx;
  margin-bottom: 8rpx;
  display: block;
}

.form-picker,
.form-input {
  background: #FFF8F0;
  border-radius: 14rpx;
  padding: 18rpx;
  font-size: 26rpx;
  color: #5D4E37;
}

.form-textarea {
  min-height: 180rpx;
  background: #FFF8F0;
  border-radius: 14rpx;
  padding: 18rpx;
  font-size: 26rpx;
  width: 100%;
  box-sizing: border-box;
  color: #5D4E37;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 6rpx);
}

.modal-actions.single .action-btn {
  width: 100%;
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.action-btn.cancel {
  background: #F5EDE4;
  color: #8B7355;
}

.action-btn.save {
  background: linear-gradient(135deg, #E8A87C 0%, #F5C6A5 100%);
  color: #fff;
}

.detail-line {
  font-size: 26rpx;
  color: #5D4E37;
  margin-bottom: 14rpx;
}

.detail-key {
  color: #8B7355;
}

.detail-content {
  display: flex;
  align-items: flex-start;
}
