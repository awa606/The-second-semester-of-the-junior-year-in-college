<view class="growth-page">
  <!-- 顶部导航：独立放在滚动区外，并给微信右上角胶囊按钮预留安全距离 -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px; height: {{navHeight}}px;">
    <view class="nav-content" style="padding-right: {{capsuleSafeRight}}px;">
      <text class="page-title">成长记录</text>
      <view class="add-btn" bindtap="onAddRecord">
        <text class="add-icon">+</text>
        <text>添加</text>
      </view>
    </view>
  </view>

  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}" style="height: calc(100vh - {{navHeight}}px);">
    <!-- 宝宝信息卡片 -->
    <view class="baby-card card">
      <view class="baby-info">
        <view class="baby-avatar">{{babyInfo.gender === 'girl' ? '👧' : '👦'}}</view>
        <view class="baby-detail">
          <text class="baby-name">{{babyInfo.name}}</text>
          <text class="baby-age">{{babyInfo.ageText}}</text>
        </view>
      </view>
      <view class="baby-stats">
        <view class="stat-item">
          <text class="stat-value">{{babyInfo.height}}</text>
          <text class="stat-label">身高(cm)</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-value">{{babyInfo.weight}}</text>
          <text class="stat-label">体重(kg)</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-value">{{babyInfo.head}}</text>
          <text class="stat-label">头围(cm)</text>
        </view>
      </view>
    </view>

    <!-- 成长曲线 -->
    <view class="curve-section card">
      <view class="curve-header">
        <text class="section-title">成长曲线</text>
        <view class="tab-switch">
          <view class="tab-item {{curveType === 'height' ? 'active' : ''}}" bindtap="switchCurve" data-type="height">身高</view>
          <view class="tab-item {{curveType === 'weight' ? 'active' : ''}}" bindtap="switchCurve" data-type="weight">体重</view>
        </view>
      </view>
      <view class="curve-chart">
        <view class="chart-area">
          <view class="chart-line">
            <view class="data-point" style="left: 10%; bottom: 20%;"></view>
            <view class="data-point" style="left: 30%; bottom: 35%;"></view>
            <view class="data-point highlight" style="left: 50%; bottom: 55%;"></view>
            <view class="data-point" style="left: 70%; bottom: 70%;"></view>
            <view class="data-point" style="left: 90%; bottom: 85%;"></view>
          </view>
          <view class="chart-grid">
            <view class="grid-line"></view>
            <view class="grid-line"></view>
            <view class="grid-line"></view>
            <view class="grid-line"></view>
          </view>
        </view>
        <view class="chart-labels">
          <text>1月</text>
          <text>3月</text>
          <text>6月</text>
          <text>9月</text>
          <text>12月</text>
        </view>
      </view>
    </view>

    <!-- 历史记录列表 -->
    <view class="history-section">
      <text class="section-title history-title">历史记录</text>
      <view class="history-list">
        <view class="history-item card {{index === records.length - 1 ? 'history-item-last' : ''}}" wx:for="{{records}}" wx:key="id" bindtap="onOpenRecordDetail" data-record="{{item}}">
          <view class="history-date">
            <text class="date-day">{{item.day}}</text>
            <text class="date-month">{{item.month}}月</text>
          </view>
          <view class="history-content">
            <text class="record-title">{{item.title}}</text>
            <view class="record-tags">
              <text class="tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="index">{{tag}}</text>
            </view>
          </view>
          <view class="history-arrow">›</view>
        </view>
      </view>
    </view>

    <!-- 真实占位，防止最后一条记录被底部导航栏和豆豆悬浮按钮盖住 -->
    <view class="bottom-safe-spacer"></view>
  </scroll-view>

  <!-- 底部导航 -->
  <tabbar active="growth" />
  
  <!-- 悬浮豆豆：保留 IP 形象，点击进入育儿助手 -->
  <doudou bottom="150" right="28" showVoice="{{showVoice}}" voiceText="{{voiceText}}" bind:doudouclick="onDoudouClick" />

  <view class="modal-mask" wx:if="{{showForm}}" catchtouchmove="true">
    <view class="modal-card form-modal card">
      <view class="modal-title">添加成长记录</view>
      <scroll-view class="form-body" scroll-y>
        <view class="form-item">
          <text class="form-label">日期</text>
          <picker mode="date" value="{{recordForm.date}}" bindchange="onFormDateChange">
            <view class="form-picker">{{recordForm.date || '请选择日期'}}</view>
          </picker>
        </view>
        <view class="form-item">
          <text class="form-label">类型</text>
          <picker mode="selector" range="{{typeOptions}}" range-key="text" value="{{recordForm.typeIndex}}" bindchange="onFormTypeChange">
            <view class="form-picker">{{typeOptions[recordForm.typeIndex].text}}</view>
          </picker>
        </view>
        <view class="form-item">
          <text class="form-label">标题</text>
          <input class="form-input" placeholder="请输入记录标题" value="{{recordForm.title}}" data-field="title" bindinput="onFormInput" />
        </view>
        <view class="form-item">
          <text class="form-label">详细内容</text>
          <textarea class="form-textarea" placeholder="请输入详细说明" value="{{recordForm.content}}" data-field="content" bindinput="onFormInput" />
        </view>
        <view class="form-item">
          <text class="form-label">身高 cm（选填）</text>
          <input class="form-input" type="digit" placeholder="例如 75" value="{{recordForm.height}}" data-field="height" bindinput="onFormInput" />
        </view>
        <view class="form-item">
          <text class="form-label">体重 kg（选填）</text>
          <input class="form-input" type="digit" placeholder="例如 9.5" value="{{recordForm.weight}}" data-field="weight" bindinput="onFormInput" />
        </view>
        <view class="form-item">
          <text class="form-label">头围 cm（选填）</text>
          <input class="form-input" type="digit" placeholder="例如 44" value="{{recordForm.head}}" data-field="head" bindinput="onFormInput" />
        </view>
      </scroll-view>
      <view class="modal-actions">
        <view class="action-btn cancel" bindtap="onCloseForm">取消</view>
        <view class="action-btn save" bindtap="onSaveRecord">保存</view>
      </view>
    </view>
  </view>

  <view class="modal-mask" wx:if="{{showDetail}}" catchtouchmove="true">
    <view class="modal-card detail-modal card">
      <view class="modal-title">记录详情</view>
      <scroll-view class="detail-body" scroll-y>
        <view class="detail-line"><text class="detail-key">日期：</text><text>{{detailRecord.date}}</text></view>
        <view class="detail-line"><text class="detail-key">类型：</text><text>{{detailRecord.typeText}}</text></view>
        <view class="detail-line"><text class="detail-key">标题：</text><text>{{detailRecord.title}}</text></view>
        <view class="detail-line detail-content"><text class="detail-key">详细内容：</text><text>{{detailRecord.content || '（无）'}}</text></view>
        <view class="detail-line" wx:if="{{detailRecord.height !== '' && detailRecord.height !== undefined}}"><text class="detail-key">身高：</text><text>{{detailRecord.height}} cm</text></view>
        <view class="detail-line" wx:if="{{detailRecord.weight !== '' && detailRecord.weight !== undefined}}"><text class="detail-key">体重：</text><text>{{detailRecord.weight}} kg</text></view>
        <view class="detail-line" wx:if="{{detailRecord.head !== '' && detailRecord.head !== undefined}}"><text class="detail-key">头围：</text><text>{{detailRecord.head}} cm</text></view>
      </scroll-view>
      <view class="modal-actions single">
        <view class="action-btn save" bindtap="onCloseDetail">我知道了</view>
      </view>
    </view>
  </view>
</view>
