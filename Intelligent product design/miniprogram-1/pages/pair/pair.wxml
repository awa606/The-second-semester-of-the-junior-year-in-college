<view class="pair-page">
  <!-- 顶部品牌区 -->
  <view class="brand-section safe-area-top">
    <view class="brand-logo">
    <image src="/assets/images/logo.jpg" mode="aspectFit" class="brand-logo" style="width: 2000rpx; height: 200rpx;"></image>
    </view>    
    <text class="brand-name">智育</text>
    <text class="brand-slogan">智能育儿·温暖相伴</text>
  </view>

  <!-- 中间扫码区 -->
  <view class="scan-section">
    <view class="scan-frame">
      <view class="frame-corner top-left"></view>
      <view class="frame-corner top-right"></view>
      <view class="frame-corner bottom-left"></view>
      <view class="frame-corner bottom-right"></view>
      <image class="scan-icon" src="/assets/icons/pair/scan-camera.png" mode="aspectFit"/>
      <text class="scan-hint">扫描设备二维码</text>
    </view>
    
    <button class="scan-btn" bindtap="onScanCode">
      <image class="btn-icon" src="/assets/icons/pair/pair-refresh.png" mode="aspectFit"/>
      扫码配对
    </button>
  </view>

  <!-- 底部提示 -->
  <view class="tip-section safe-area-bottom">
    <text class="tip-text">将设备二维码放入扫描框内</text>
    <text class="tip-text">即可完成设备配对连接</text>
  </view>

  <!-- 悬浮豆豆 -->
  <doudou 
    bottom="{{isIphoneX ? 300 : 260}}"
    right="30"
    showVoice="{{showVoice}}"
    voiceText="{{voiceText}}"
  />
</view>
