page {
  min-height: 100%;
  height: 100%;
  overflow-y: auto;
}

/* 全局样式 - 智育小程序奶油米色温馨治愈风格 */

page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  background-color: #FFF8F0;
  color: #5D4E37;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 奶油米色主题色 */
page {
  --primary-color: #E8A87C;
  --primary-light: #F5E6D3;
  --primary-dark: #D4956A;
  --bg-color: #FFF8F0;
  --bg-card: #FFFFFF;
  --text-primary: #5D4E37;
  --text-secondary: #8B7355;
  --text-hint: #B8A090;
  --border-color: #F0E6DC;
  --shadow-soft: 0 4rpx 20rpx rgba(93, 78, 55, 0.08);
  --shadow-hover: 0 8rpx 30rpx rgba(93, 78, 55, 0.12);
}

/* 通用按钮样式 */
.btn-primary {
  background: linear-gradient(135deg, #E8A87C 0%, #F5C6A5 100%);
  color: #FFFFFF;
  border: none;
  border-radius: 50rpx;
  padding: 24rpx 60rpx;
  font-size: 32rpx;
  font-weight: 500;
  box-shadow: var(--shadow-soft);
  transition: all 0.3s ease;
}

.btn-secondary {
  background-color: var(--bg-card);
  color: var(--primary-color);
  border: 2rpx solid var(--primary-color);
  border-radius: 50rpx;
  padding: 24rpx 60rpx;
  font-size: 32rpx;
  font-weight: 500;
}

/* 卡片样式 */
.card {
  background-color: var(--bg-card);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: var(--shadow-soft);
}

/* 标题样式 */
.page-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  text-align: center;
}

/* 安全区域 */
.safe-area-top {
  padding-top: env(safe-area-inset-top);
}

.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* 动画 */
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.7; }
}

/* 文字省略 */
.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-ellipsis-2 {
  line-height: 1.6;
  max-height: 3.2em;
  overflow: hidden;
}
